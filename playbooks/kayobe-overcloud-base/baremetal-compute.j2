{% raw %}
---
ironic_driver: ipmi
ironic_driver_info:
  ipmi_address: 0.0.0.0
  ipmi_username: username
  ipmi_password: password
  ipmi_port: "{{ node_ipmi_port }}"
ironic_properties:
  capabilities: "{{ ironic_capabilities }}"
ironic_resource_class: "example_resource_class"
{% endraw %}
ironic_capabilities: "boot_option:local,boot_mode:{{ ironic_boot_mode }}"
