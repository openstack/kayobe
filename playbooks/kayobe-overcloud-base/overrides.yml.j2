---
{% set overcloud_network_engine = ci_network_engine | default('default') %}

{% if overcloud_network_engine != 'default' %}
network_engine: {{ overcloud_network_engine }}
{% endif %}

docker_daemon_debug: true
# Use the OpenStack infra's Dockerhub mirror.
docker_registry_mirrors:
  - "http://{{ zuul_site_mirror_fqdn }}:8082/"

{% if ci_kolla_build_images | bool %}
# Kolla is installed on the container image builder by the Kayobe Ansible
# user, so use a copy of the source checkout that it can read.
kolla_source_url: "{{ ci_kolla_build_src_dir ~ '/' ~ zuul.projects['opendev.org/openstack/kolla'].src_dir }}"

# Build images with the same name as the published images that Kolla Ansible
# deploys by default, so that it uses the local images rather than pulling.
kolla_docker_registry: "quay.io"
{% if not ci_kolla_build_all_images | bool %}

# Only build enabled images affected by the changes under test. Match image
# names that contain a prefix after a hyphen, such as ironic-neutron-agent for
# neutron, since these images also install the project.
overcloud_container_image_sets:
  - regexes: >-
      {% raw %}{{ overcloud_container_image_regexes |
         select('regex', '(^\^?|-)(' ~ ci_kolla_build_image_prefixes | join('|') ~ ')') |
         join(' ') }}{% endraw %}
{# NOTE: Keep the blank line below. trim_blocks removes the newline after the
   endraw tag, so without it the next line joins the folded scalar. #}

ci_kolla_build_image_prefixes: {{ ci_kolla_build_image_prefixes | to_json }}
{% endif %}
{% if ci_kolla_build_source_projects | length > 0 %}

# Build the changes under test from local copies of their source checkouts.
# This replaces the default bifrost-base source, which is only used by seed
# images.
kolla_sources:
{% for project in ci_kolla_build_source_projects %}
{% set sections = ci_kolla_build_config_defaults.kolla_build_sources[project.name] %}
{% for section in ([sections] if sections is string else sections) %}
  {{ section }}:
    type: "local"
    location: "{{ ci_kolla_build_src_dir }}/{{ project.src_dir }}"
{% endfor %}
{% endfor %}
{% endif %}
{% else %}
kolla_source_url: "{{ ansible_env.PWD ~ '/' ~ zuul.projects['opendev.org/openstack/kolla'].src_dir }}"
{% endif %}
kolla_source_version: "{{ zuul.projects['opendev.org/openstack/kolla'].checkout }}"
kolla_ansible_source_url: "{{ ansible_env.PWD ~ '/' ~ zuul.projects['opendev.org/openstack/kolla-ansible'].src_dir }}"
kolla_ansible_source_version: "{{ zuul.projects['opendev.org/openstack/kolla-ansible'].checkout }}"
kolla_ansible_requirements_yml: "/tmp/kolla-ansible-requirements.yml"
kolla_openstack_logging_debug: True
pip_upper_constraints_file: "/tmp/upper-constraints.txt"

# Force system clock synchronisation
ntp_force_sync: True

# Use the CI infra's PyPI mirror.
pip_local_mirror: true
pip_index_url: "http://{{ zuul_site_mirror_fqdn }}/pypi/simple"
pip_trusted_hosts:
  - "{{ zuul_site_mirror_fqdn }}"

# NOTE(mgoddard): CentOS 8 removes interfaces from their bridge during ifdown,
# and removes the bridge if there are no interfaces left. When Kayobe bounces
# veth links plugged into the bridge, it causes the bridge which has the IP we
# are using for SSH to be removed. Use a dummy interface.
aio_bridge_ports:
  - dummy1

# Generate a password for libvirt SASL authentication.
compute_libvirt_sasl_password: "{% raw %}{{ lookup('password', '/tmp/libvirt-sasl-password') }}{% endraw %}"

# Enable ironic for testing baremetal compute.
kolla_enable_ironic: true

# extra RAM usage is causing the OOM killer to terminate
# Tenks VMs. Disable Heat and Horizon to free up enough memory.
kolla_enable_heat: false
kolla_enable_horizon: false

# Enable Mariabackup for testing database backups
kolla_enable_mariabackup: true

# Enable Cinder with an NFS backend to test block storage.
kolla_enable_cinder: true
kolla_enable_cinder_backend_nfs: true

# Cinder backup defaults to the Ceph driver, and no Ceph cluster is deployed.
kolla_enable_cinder_backup: false

{% if tls_enabled %}
kolla_enable_nova_libvirt_container: false
compute_libvirt_enable_tls: true

kolla_enable_tls_external: "yes"
kolla_enable_tls_internal: "yes"

kolla_ironic_kernel_append_params_extra:
  - ipa-insecure=1
{% endif %}

# Support overriding container_engine
container_engine: "{{ container_engine }}"

# Deploy a test container.
controller_containers:
  node_exporter:
    image: "quay.io/prometheus/node-exporter"
    tag: "latest"
